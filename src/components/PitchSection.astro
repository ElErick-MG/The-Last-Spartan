---
import Roadmap from './Roadmap.astro';
---

<section class="section" id="pitch" aria-labelledby="pitch-title">
  <div class="container">
    <h2 class="section__title reveal" id="pitch-title">
      Visión comercial para publishers e inversores
    </h2>
    <p class="section__lead reveal">
      Una propiedad intelectual con identidad propia, alcance realista y una ruta clara
      hasta el lanzamiento.
    </p>

    <div class="card-grid card-grid--wide">
      <article class="card reveal">
        <h3 class="card__title">Género y público objetivo</h3>
        <p class="card__text">
          Acción-aventura narrativa 2D con estética de novela gráfica. Para fans de
          Blasphemous, 300, God of War y Valiant Hearts.
        </p>
      </article>
      <article class="card reveal">
        <h3 class="card__title">Propuesta única de valor</h3>
        <p class="card__text">
          Una historia íntima y humana dentro de la brutalidad de la guerra espartana,
          construida con arquitectura modular y reutilización inteligente de escenarios.
        </p>
      </article>
    </div>

    <Roadmap />
  </div>
</section>
