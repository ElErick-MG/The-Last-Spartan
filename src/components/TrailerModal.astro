---
/**
 * Modal de tráiler/demo. Se abre desde cualquier elemento con
 * `data-modal-open`; la interacción la gestiona `trailer-modal.js`.
 */
---

<div
  class="modal"
  id="trailer-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="trailer-modal-title"
  data-modal
  hidden
>
  <div class="modal__dialog" data-modal-dialog>
    <header class="modal__header">
      <h3 class="modal__title" id="trailer-modal-title">
        The Last Spartan: avance del proyecto
      </h3>
      <button class="btn btn--compact" type="button" data-modal-close>Cerrar</button>
    </header>

    <div class="modal__video">
      <div>
        <p class="modal__play" aria-hidden="true">▶</p>
        <p class="modal__note">
          El tráiler y la demo jugable de la beta de la Parte 1 se publicarán aquí.<br />
          Mientras tanto, este espacio muestra el estado del proyecto.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { mountTrailerModal } from '../scripts/features/trailer-modal.js';
  import { mountSafely } from '../scripts/core/mount.js';
  import { query, queryAll } from '../scripts/core/dom.js';

  const modal = query('[data-modal]');

  if (modal) {
    mountSafely('trailer-modal', () =>
      mountTrailerModal({ modal, openers: queryAll('[data-modal-open]') }),
    );
  }
</script>
